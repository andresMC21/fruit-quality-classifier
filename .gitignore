__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
.env
.DS_Store
kaggle.json

# Datos pesados: no se versionan. Las imagenes propias se comparten por la carpeta
# en la nube indicada en data/README.md; aqui solo van anotaciones y .gitkeep.
data/raw/kaggle/*
data/raw/mixed_quality/*
# Con "/**" + "!/**/" git sigue entrando en las subcarpetas y puede rescatar sus .gitkeep
# (con "data/interim/*" la subcarpeta segmented/ quedaba excluida entera).
data/interim/**
!data/interim/**/
data/processed/**
!data/processed/**/
!data/processed/splits.csv
experiments/checkpoints/*

!**/.gitkeep
!data/annotations/*.csv

# Bases públicas descargadas (pesadas) y archivos de trabajo locales
Fruit grade/
Fruits Grade.zip
experiments/logs/*.jpg
experiments/logs/tmp/
experiments/checkpoints/*.h5
experiments/checkpoints/*.joblib
experiments/checkpoints/*.json

experiments/logs/*.png

# Scripts locales de trabajo (no se versionan)
commit_por_etapas.sh
.pytest_cache/

# Cualquier dato crudo y caches de características (no versionar)
data/raw/afruitdb/*
data/raw/fruit grade/*
data/raw/sultana/*
*.npz
*.h5
*.zip

# Los modelos exportados de models/ (.joblib) SI se versionan; los checkpoints no
!models/*.joblib
